diff --git a/src/dxvk/dxvk_unbound.cpp b/src/dxvk/dxvk_unbound.cpp
index 63e3f4d5..ac9b1380 100644
--- a/src/dxvk/dxvk_unbound.cpp
+++ b/src/dxvk/dxvk_unbound.cpp
@@ -53,6 +53,136 @@ namespace dxvk {
   }
 
 
+  std::vector<Rc<DxvkImage>> DxvkUnboundResources::createImages() {
+    std::vector<Rc<DxvkImage>> images;
+
+    if (m_imagesReady.load(std::memory_order_acquire))
+      return images;
+
+    std::lock_guard lock(m_mutex);
+
+    if (m_imageView2D != nullptr)
+      return images;
+
+    m_imageView1D = createImageView(VK_IMAGE_TYPE_1D, VK_IMAGE_VIEW_TYPE_1D_ARRAY, 1u, 0u, images);
+    m_imageView2D = createImageView(VK_IMAGE_TYPE_2D, VK_IMAGE_VIEW_TYPE_2D_ARRAY, 6u, VK_IMAGE_CREATE_CUBE_COMPATIBLE_BIT, images);
+    m_imageView3D = createImageView(VK_IMAGE_TYPE_3D, VK_IMAGE_VIEW_TYPE_3D, 1u, 0u, images);
+
+    // Create every view type up front so lookups need no locking
+    for (uint32_t i = 0; i < m_imageViewHandles.size(); i++) {
+      auto type = VkImageViewType(i);
+
+      switch (type) {
+        case VK_IMAGE_VIEW_TYPE_1D:
+        case VK_IMAGE_VIEW_TYPE_1D_ARRAY:
+          m_imageViewHandles[i] = m_imageView1D->handle(type);
+          break;
+
+        case VK_IMAGE_VIEW_TYPE_3D:
+          m_imageViewHandles[i] = m_imageView3D->handle(type);
+          break;
+
+        case VK_IMAGE_VIEW_TYPE_CUBE_ARRAY:
+          if (!m_device->features().core.features.imageCubeArray)
+            break;
+          [[fallthrough]];
+
+        default:
+          m_imageViewHandles[i] = m_imageView2D->handle(type);
+      }
+    }
+
+    m_imagesReady.store(true, std::memory_order_release);
+    return images;
+  }
+
+
+  VkImageView DxvkUnboundResources::imageViewHandle(VkImageViewType type) {
+    if (unlikely(!m_imagesReady.load(std::memory_order_acquire)))
+      return VK_NULL_HANDLE;
+
+    return uint32_t(type) < m_imageViewHandles.size()
+      ? m_imageViewHandles[type]
+      : VK_NULL_HANDLE;
+  }
+
+
+  VkBufferView DxvkUnboundResources::bufferViewHandle() {
+    VkBufferView view = m_bufferViewHandle.load();
+
+    if (likely(view != VK_NULL_HANDLE))
+      return view;
+
+    // Make sure the backing buffer exists before taking the lock
+    bufferHandle();
+
+    std::lock_guard lock(m_mutex);
+    view = m_bufferViewHandle.load();
+
+    if (view)
+      return view;
+
+    DxvkBufferViewKey key;
+    key.format = VK_FORMAT_R32_UINT;
+    key.usage = VK_BUFFER_USAGE_UNIFORM_TEXEL_BUFFER_BIT
+              | VK_BUFFER_USAGE_STORAGE_TEXEL_BUFFER_BIT;
+    key.offset = 0u;
+    key.size = m_buffer->info().size;
+
+    m_bufferView = m_buffer->createView(key);
+    view = m_bufferView->handle();
+
+    m_bufferViewHandle.store(view, std::memory_order_release);
+    return view;
+  }
+
+
+  Rc<DxvkImageView> DxvkUnboundResources::createImageView(
+          VkImageType     type,
+          VkImageViewType viewType,
+          uint32_t        layers,
+          VkImageCreateFlags flags,
+          std::vector<Rc<DxvkImage>>& images) {
+    DxvkImageCreateInfo info;
+    info.type        = type;
+    info.format      = VK_FORMAT_R8G8B8A8_UNORM;
+    info.flags       = flags;
+    info.sampleCount = VK_SAMPLE_COUNT_1_BIT;
+    info.extent      = { 1u, 1u, 1u };
+    info.numLayers   = layers;
+    info.mipLevels   = 1u;
+    info.usage       = VK_IMAGE_USAGE_SAMPLED_BIT
+                     | VK_IMAGE_USAGE_STORAGE_BIT
+                     | VK_IMAGE_USAGE_TRANSFER_DST_BIT;
+    info.stages      = VK_PIPELINE_STAGE_TRANSFER_BIT
+                     | m_device->getShaderPipelineStages();
+    info.access      = VK_ACCESS_TRANSFER_WRITE_BIT
+                     | VK_ACCESS_SHADER_READ_BIT
+                     | VK_ACCESS_SHADER_WRITE_BIT;
+    info.tiling      = VK_IMAGE_TILING_OPTIMAL;
+    info.layout      = VK_IMAGE_LAYOUT_GENERAL;
+    info.shared      = VK_TRUE;
+    info.debugName   = "Null image";
+
+    Rc<DxvkImage> image = m_device->createImage(info,
+      VK_MEMORY_PROPERTY_DEVICE_LOCAL_BIT);
+    images.push_back(image);
+
+    DxvkImageViewKey key;
+    key.viewType   = viewType;
+    key.usage      = VK_IMAGE_USAGE_SAMPLED_BIT
+                   | VK_IMAGE_USAGE_STORAGE_BIT;
+    key.format     = info.format;
+    key.aspects    = VK_IMAGE_ASPECT_COLOR_BIT;
+    key.mipIndex   = 0u;
+    key.mipCount   = 1u;
+    key.layerIndex = 0u;
+    key.layerCount = layers;
+
+    return image->createView(key);
+  }
+
+
   Rc<DxvkSampler> DxvkUnboundResources::createSampler() {
     DxvkSamplerKey info;
     info.setFilter(VK_FILTER_LINEAR, VK_FILTER_LINEAR, VK_SAMPLER_MIPMAP_MODE_LINEAR);
